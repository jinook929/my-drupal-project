# Composer-managed dependencies (restored via `composer install`)
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/
/drush/contrib/

# Environment-specific / sensitive settings.
# settings.php is tracked so shared settings (e.g. config_sync_directory) reach
# the whole team. DB credentials and hash_salt live in the ignored,
# DDEV-generated settings.ddev.php.
/web/sites/*/settings.ddev.php
/web/sites/*/settings.local.php
/web/sites/*/services*.yml

# User-uploaded files
/web/sites/*/files
/web/sites/*/private

# Multisite test environment
/web/sites/simpletest

# ETC
.DS_Store
tmp/